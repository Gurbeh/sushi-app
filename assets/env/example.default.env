# Local TDLib credentials only (my.telegram.org). No product API URLs.
# Copy to default.env for local runs (default.env is gitignored).

OXPLAYER=true
# Leave empty — Sushi does not use an HTTP API base URL.
OXPLAYER_API_BASE_URL=

# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# development flavor — from `npm run env:pull` (Infisical MAIN_BOTS / INIT_BOTS). Ignored in production flavor.
# OXPLAYER_BOT_USERNAME=
# OXPLAYER_INIT_BOT_USERNAME=

# Do not set SENTRY_DSN or TELEGRAM_HOSTED_WEBAPP_HTTPS_URL in this fork.
